# <APP_NAME> — environment reference.
#
# PUBLIC build-time vars (safe in the frontend bundle) are prefixed VITE_.
# Everything else is a Worker var or SECRET and must never reach the browser.

# ---- Feature flags (Worker vars). Unset === false. Enable ONE AT A TIME. ----
USE_NEW_API=false        # master switch: mounts /api/* at all
USE_D1=false             # allow database reads/writes
USE_R2=false             # allow object storage routes
USE_KV=false             # allow KV-backed features
USE_WORKER_AUTH=false    # allow Worker-issued sessions
USE_TURNSTILE=false      # enforce captcha on public writes

# ---- Worker vars (non-secret configuration) ----
SITE_URL=https://example.com
EMAIL_PROVIDER=          # resend | postmark | mailchannels
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=
ADMIN_NOTIFY_EMAIL=
REQUIRE_CF_ACCESS=false  # demand a Cloudflare Access assertion on /api/admin/*

# ---- SECRETS: `wrangler secret put <NAME>`. Never commit. Never VITE_. ----
# SESSION_PEPPER          32+ random bytes; also signs R2 grants
# TURNSTILE_SECRET        Turnstile server key (site key is public)
# EMAIL_API_KEY           provider API key
# STRIPE_SECRET_KEY       sk_...
# STRIPE_WEBHOOK_SECRET   whsec_...

# ---- Public frontend vars ----
VITE_TURNSTILE_SITE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
