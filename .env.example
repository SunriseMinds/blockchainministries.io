# =============================================================================
# Blockchain Ministries — Environment Variable TEMPLATE
# =============================================================================
# Copy to `.env` (or `.env.local`) for local dev, or set these in the
# Cloudflare Pages / Workers dashboard for deployment.
#
# THIS FILE CONTAINS PLACEHOLDERS ONLY. Never commit real secrets.
# `.env`, `.env.*`, and `.dev.vars` are git-ignored.
# =============================================================================

# ------------------------------------------------------------------------
# PUBLIC — safe to expose in the built frontend (Vite inlines VITE_* vars).
# ------------------------------------------------------------------------
VITE_NEXT_PUBLIC_SITE_URL=https://blockchainministries.io
VITE_NEXT_PUBLIC_XRPL_EXPLORER=https://livenet.xrpl.org

# Cloudflare-native backend cutover switch (M8). MUST remain unset/false in
# production — the frontend continues talking to Supabase directly. Set to
# 'true' only in a preview environment to route auth/membership/ordination/
# admin/payments UI through the /api/* Worker instead. See
# docs/CLOUDFLARE_TARGET_ARCHITECTURE.md and the M8 report for what this
# does and does not affect.
VITE_USE_CLOUDFLARE_API=false

# Supabase (transitional backend — public anon key only; protected by RLS).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Stripe publishable (public) key — pk_test_... or pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# PayPal client id (public).
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id

# ------------------------------------------------------------------------
# SERVER-SIDE ONLY — NEVER expose to the browser, NEVER commit.
# These belong in Supabase Edge Function secrets today, and in
# Cloudflare Worker/Pages Functions secrets after backend migration.
# Values below are placeholders; set real values via secret storage.
# ------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE=set-in-server-secret-store
# STRIPE_SECRET_KEY=set-in-server-secret-store
# STRIPE_WEBHOOK_SECRET=set-in-server-secret-store
# STRIPE_PRICE_DONATION=set-in-server-secret-store
# COINBASE_COMMERCE_API_KEY=set-in-server-secret-store
# COINBASE_COMMERCE_WEBHOOK_SECRET=set-in-server-secret-store
# EMAIL_FROM=noreply@blockchainministries.io
# SMTP_HOST=set-in-server-secret-store
# SMTP_PORT=587
# SMTP_USER=set-in-server-secret-store
# SMTP_PASS=set-in-server-secret-store
# XRPL_NETWORK=mainnet
# XRPL_ISSUER_ADDRESS=set-in-server-secret-store
# XRPL_SEED=set-in-server-secret-store   # signing seed — server-side ONLY, never in frontend or Git
