{
  // Cloudflare Workers static-assets configuration for the Blockchain Ministries
  // React 18 + Vite single-page app. Deploys the pre-built ./dist directory as
  // static assets through the Workers Builds Git integration.
  //
  // A minimal Worker (worker/index.js) provides SPA routing that ALSO returns a
  // genuine 404 for missing file-like requests (e.g. /assets/app-abc123.js) rather
  // than masking them with index.html. Cloudflare serves matching static assets
  // directly and only invokes the Worker for requests that don't match an asset.
  //
  // Secrets (Stripe secret, SMTP, XRPL seed, Supabase service role, tokens) must
  // NEVER live here. Only public build-time VITE_* values belong in the build env.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blockchainministries-io",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.js",
  "assets": {
    // Vite build output.
    "directory": "./dist",
    // Binding used by worker/index.js to serve index.html for client-side routes.
    "binding": "ASSETS"
  },

  // ---------------------------------------------------------------------------
  // Parallel Cloudflare backend bindings (Phase 2D).
  //
  // These make the resources REACHABLE, they do not switch anything on. Every
  // feature flag (USE_NEW_API / USE_D1 / USE_R2 / USE_WORKER_AUTH /
  // USE_TURNSTILE) is deliberately ABSENT here, and an absent variable is
  // false — so /api/* still returns 503 and the SPA still talks to Supabase.
  // Flags are enabled per-environment in the dashboard, one at a time.
  // ---------------------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blockchain-ministries-db",
      "database_id": "1aebe562-6eff-4910-b5c0-450bcc1ea19d",
      // Used by `wrangler dev` and preview deployments.
      "preview_database_id": "88e30d07-1939-495a-8cf4-3088a2e8ef81"
    }
  ],
  "r2_buckets": [
    { "binding": "PUBLIC_FILES", "bucket_name": "bm-public" },
    { "binding": "PROTECTED_FILES", "bucket_name": "bm-protected" }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "572ec235d6c94962aa265295879d837c",
      "preview_id": "c9e5125bf97f47d49c7bf53e1644ef98"
    }
  ]
}
